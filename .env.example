# Enterprise Generative AI Knowledge Platform
# Environment Variables Template

# --- Groq API ---
GROQ_API_KEY=your_groq_api_key_here

# --- ChromaDB ---
CHROMA_PERSIST_DIR=./data/chroma_db

# --- Document Storage ---
DOCUMENT_UPLOAD_DIR=./data/uploads

# --- Application ---
APP_NAME=Enterprise GenAI Knowledge Platform
APP_ENV=development
LOG_LEVEL=INFO

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Frontend ---
STREAMLIT_PORT=8501
API_BASE_URL=http://localhost:8000
